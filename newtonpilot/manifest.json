{
  "manifest_version": 3,
  "name": "NewtonPilot - Quiz & Assessment Companion",
  "version": "1.0.0",
  "description": "Assists with detecting, reviewing, and analyzing practice quiz questions on Newton School student portal.",
  "icons": {
    "16": "assets/icons/icon16.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "NewtonPilot",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "48": "assets/icons/icon48.png",
      "128": "assets/icons/icon128.png"
    }
  },
  "permissions": [
    "activeTab",
    "storage",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "https://my.newtonschool.co/*",
    "http://localhost:11434/*",
    "http://127.0.0.1:11434/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "commands": {
    "step_question": {
      "suggested_key": {
        "default": "Alt+Shift+S",
        "mac": "Alt+Shift+S"
      },
      "description": "Step 1 Question (Extract -> Reason -> Click)"
    },
    "toggle_pilot": {
      "suggested_key": {
        "default": "Alt+Shift+P",
        "mac": "Alt+Shift+P"
      },
      "description": "Start or Pause Auto-Pilot"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://my.newtonschool.co/*"
      ],
      "js": [
        "utils/messaging.js",
        "scripts/extractor.js",
        "scripts/observer.js",
        "scripts/executor.js",
        "scripts/agent.js",
        "scripts/content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
